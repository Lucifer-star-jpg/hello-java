pipeline {
    agent any

    environment {
        IMAGE_NAME = 'mythical45/neww'
        CONTAINER_PORT = '8080'
        HOST_PORT = '5006'
    }

    stages {
        stage('Git Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/Lucifer-star-jpg/hello-java.git'
            }
        }

        stage('Maven Build') {
            steps {
                sh 'mvn clean package'
            }
        }

        stage('Docker Build') {
            steps {
                sh "docker build -t ${IMAGE_NAME} ."
            }
        }

        stage('Docker Run') {
            steps {
                sh "docker run -d -p ${HOST_PORT}:${CONTAINER_PORT} ${IMAGE_NAME}"
            }
        }

        stage('Docker Push') {
            steps {
                sh "docker push ${IMAGE_NAME}"
            }
        }

        stage('Configure Kubeconfig') {
            steps {
                sh 'aws eks --region us-east-1 update-kubeconfig --name my-cluster'
            }
        }

        stage('Kubernetes Deployment') {
            steps {
                sh 'kubectl apply -f Deployment.yaml'
            }
        }

        stage('Show Service Info') {
            steps {
                script {
                    echo 'Fetching Kubernetes service external IP and port...'
                    sh '''
                    echo "Service Info:"
                    kubectl get svc java-app-service -o wide
                    '''
                }
            }
        }

        stage('Show all IPs') {
            steps {
                script {
                    echo 'Fetching instance names and public IPs...'
                    sh '''
                    aws ec2 describe-instances \
                    --query "Reservations[*].Instances[*].{Name: Tags[?Key=='Name'] | [0].Value, PublicIP: PublicIpAddress}" \
                    --output table
                    '''
                }
            }
        }
    }
}





